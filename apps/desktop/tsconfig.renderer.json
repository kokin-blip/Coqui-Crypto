{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"]
}
