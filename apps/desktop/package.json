{
  "name": "@coqui/desktop",
  "version": "0.1.0-beta.4",
  "description": "Evidence-first crypto research and paper-trading workstation with live execution disabled.",
  "author": "Coqui Crypto",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "exports": { ".": { "types": "./dist/main/composition.d.ts", "default": "./dist/main/composition.js" } },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "tsc -b && node scripts/build-preload.mjs && vite build",
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build && electron scripts/smoke.mjs",
    "perf": "pnpm build && electron scripts/perf.mjs",
    "screenshots:review": "pnpm build && electron scripts/visual-review.mjs",
    "package": "pnpm build && electron-builder --config electron-builder.yml",
    "package:mac": "pnpm build && electron-builder --config electron-builder.yml --mac --arm64",
    "package:win": "pnpm build && electron-builder --config electron-builder.yml --win --x64",
    "smoke:packaged": "node scripts/packaged-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@coqui/adapters": "workspace:*",
    "@coqui/contracts": "workspace:*",
    "@coqui/core": "workspace:*",
    "@coqui/observability": "workspace:*",
    "@coqui/services": "workspace:*",
    "@coqui/storage": "workspace:*",
    "@coqui/ui-kit": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@ionic/react": "9.0.1",
    "@tanstack/react-query": "5.101.4",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/lodash": "4.17.23",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "esbuild": "0.28.2",
    "png2icons": "2.0.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
